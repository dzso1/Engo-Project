# ===== ENGO Learning Hub - biến môi trường mẫu (copy thành .env) =====
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=engo
DB_USER=engo_app
DB_PASSWORD=
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-dai
NODE_ENV=development
RESEND_API_KEY=

# ===== AI: chuỗi nhà cung cấp, thử lần lượt theo thứ tự này; nhà nào hết hạn mức (429) sẽ tự bỏ qua =====
# Chỉ cần ít nhất 1 key. Tất cả bên dưới đều có gói MIỄN PHÍ (trừ OpenAI).
AI_PROVIDER_ORDER=gemini,groq,cerebras,mistral,openrouter,openai

# Google AI Studio - https://aistudio.google.com/apikey (miễn phí ~500 req/ngày mỗi model; nhiều key cách nhau dấu phẩy)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Groq - https://console.groq.com/keys (miễn phí ~14.400 req/ngày, Llama 3.3 70B, rất nhanh) - KHUYÊN DÙNG
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Cerebras - https://cloud.cerebras.ai (miễn phí 1 triệu token/ngày)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Mistral - https://console.mistral.ai (gói Experiment miễn phí)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter - https://openrouter.ai/keys (các model đuôi :free, ~50 req/ngày; nạp 10$ một lần -> 1000 req/ngày)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# OpenAI (trả phí)
OPENAI_API_KEY=

# Ollama - hoàn toàn miễn phí, chạy trên máy của bạn: cài từ https://ollama.com rồi `ollama pull qwen2.5:3b`
# Khi chạy local, server tự dùng Ollama trước (http://127.0.0.1:11434). Muốn Railway dùng Ollama trên máy bạn:
# mở tunnel (vd `cloudflared tunnel --url http://localhost:11434`) rồi đặt OLLAMA_HOST=https://<tunnel>.trycloudflare.com
OLLAMA_HOST=
OLLAMA_MODEL=

AI_FAST_ORDER=groq,cerebras,gemini

# In log gọi AI để gỡ lỗi: AI_DEBUG=1
