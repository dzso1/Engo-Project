
/* ===================== HỌC THEO UNIT 1–12 ===================== */
.unit-panel { margin-bottom: 18px; }
.unit-chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.unit-chip {
  border: 1px solid #d7dde5; background: #fff; color: #334155; border-radius: 8px;
  padding: 6px 12px; font-weight: 700; font-size: 13px; cursor: pointer; transition: .15s;
}
.unit-chip:hover { border-color: #16a34a; color: #16a34a; }
.unit-chip.active { background: #16a34a; border-color: #16a34a; color: #fff; }
.unit-body { margin-top: 14px; }
.unit-sec { margin-bottom: 18px; }
.unit-sec-title { font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;
  border-bottom: 1px solid #e8edf2; padding-bottom: 6px; }
.unit-word-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
.unit-word, .unit-line { display: flex; gap: 9px; align-items: flex-start;
  border: 1px solid #e8edf2; border-radius: 9px; padding: 8px 10px; background: #fff; }
.unit-line { margin-bottom: 7px; }
.unit-say { flex: none; border: 1px solid #d7dde5; background: #f8fafc; border-radius: 7px;
  width: 30px; height: 30px; cursor: pointer; font-size: 14px; line-height: 1; }
.unit-say:hover { background: #ecfdf5; border-color: #16a34a; }
.unit-pos { font-size: 11px; color: #7c3aed; background: #f5f3ff; border-radius: 4px; padding: 1px 5px; font-weight: 700; }
.unit-vi { font-size: 13px; color: #334155; margin-top: 2px; }
.unit-lv { display: inline-block; border-radius: 5px; padding: 1px 7px; font-size: 12px; font-weight: 700; margin-right: 6px; }
.unit-lv.lv1 { background: #ecfdf5; color: #047857; }
.unit-lv.lv2 { background: #fff7ed; color: #b45309; }
.unit-lv.lv3 { background: #fef2f2; color: #b91c1c; }
.unit-focus { background: #f0fdf4; border-left: 3px solid #16a34a; padding: 8px 12px; border-radius: 0 7px 7px 0; margin-bottom: 12px; }
.unit-rule { border: 1px solid #e8edf2; border-radius: 9px; padding: 11px 13px; margin-bottom: 10px; }
.unit-rule h4 { font-size: 14px; margin-bottom: 5px; color: #0f172a; }
.unit-form { font-family: ui-monospace, Consolas, monospace; font-size: 13px; background: #f8fafc;
  border: 1px dashed #cbd5e1; border-radius: 6px; padding: 6px 9px; margin: 7px 0; }
.unit-ok { color: #047857; font-size: 13px; }
.unit-no { color: #b91c1c; font-size: 13px; text-decoration: line-through; }
.unit-codes { margin: 12px 0; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.unit-code { font-size: 12px; font-weight: 700; color: #b45309; border: 1px solid #fcd9a6;
  background: #fffbeb; border-radius: 5px; padding: 2px 7px; }
.unit-quiz { border-top: 1px dashed #e2e8f0; padding-top: 12px; margin-top: 12px; }
.unit-quiz h4 { font-size: 14px; margin-bottom: 8px; }
.unit-q { margin-bottom: 12px; }
.unit-opts { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 5px; }
.unit-opt { border: 1px solid #d7dde5; background: #fff; border-radius: 7px; padding: 6px 12px;
  font-size: 13px; cursor: pointer; transition: .15s; }
.unit-opt:hover { border-color: #16a34a; }
.unit-opt.picked { border-color: #2563eb; background: #eff6ff; font-weight: 700; }
.unit-opt.right { border-color: #16a34a; background: #ecfdf5; color: #047857; font-weight: 700; }
.unit-opt.wrong { border-color: #dc2626; background: #fef2f2; color: #b91c1c; }
.unit-gap { border: 1px solid #d7dde5; border-radius: 7px; padding: 6px 10px; font-size: 14px; width: 220px; margin-top: 5px; }
.unit-gap.right { border-color: #16a34a; background: #ecfdf5; }
.unit-gap.wrong { border-color: #dc2626; background: #fef2f2; }
.unit-script { margin-top: 12px; background: #f8fafc; border: 1px solid #e8edf2; border-radius: 8px;
  padding: 11px 13px; font-size: 14px; line-height: 1.6; color: #334155; }
.unit-script.hidden { display: none; }
@media (max-width: 640px) {
  .unit-word-grid { grid-template-columns: 1fr; }
  .unit-gap { width: 100%; }
}
